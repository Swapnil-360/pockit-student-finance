# Gemini API Key (Enter your key below)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Optional Supabase Cloud Credentials (leave empty for instant local SQLite fallback)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin Panel Credentials & Token Secret
ADMIN_EMAIL=admin@pockit.app
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_SECRET=your_random_admin_hmac_secret_here
